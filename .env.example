# ── Database ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_database_password_here
DB_NAME=sik

# JWT Secret (CRITICAL: Use a strong random value in production)
# Generate with: openssl rand -hex 32
SECRETTOKEN=REPLACE_WITH_STRONG_SECRET_GENERATED_BY_OPENSSL

# ── Server ───────────────────────────────────────────────────────────────
PORT=4002
NODE_ENV=development

# AES Encryption Keys for the Khanza `user` table.
# Used to verify legacy (AES) passwords and to mirror new passwords so the
# SIMRS Khanza desktop/PHP apps keep working (decision D2).
DB_AES_KEY_USER=your_aes_user_key
DB_AES_KEY_PASS=your_aes_pass_key

# URL webapps
HOST_WEB=http://localhost
HOST_WEB_PORT=80
HOST_WEB_ROOT=webapps

# ── Redis (rate limiter / cache) ─────────────────────────────────────────
# Set to true to enable Redis; falls back to in-memory limiter + memory cache.
REDIS_ENABLED=false

# ── Database Connection Pool ─────────────────────────────────────────────
DB_CONNECTION_LIMIT=25
DISABLE_QUERY_LOG=false

# Log queries slower than this many ms (default 1000).
SLOW_QUERY_MS=1000

# ── Access Control ───────────────────────────────────────────────────────
# Fail-safe read-only by default: mobile writes are allowed ONLY when this
# is explicitly 'true'. The app learns the real policy from
# GET /auth/capabilities (write_access).
ALLOW_MOBILE_WRITE=false

# ── Network hardening ────────────────────────────────────────────────────
# Only set to 'true' when a trusted reverse proxy (nginx/CF) stands in front
# and overwrites X-Forwarded-For. When false, rate limiting and audit IPs
# use the raw socket address (clients cannot spoof the header).
TRUST_PROXY=false

# Comma-separated origin allowlist for browser (Flutter Web) builds.
# Empty + production  => cross-origin blocked; empty + dev => reflect origin.
# Example: CORS_ORIGINS=https://edokter.rs.example.com
CORS_ORIGINS=

# ── Notifications ────────────────────────────────────────────────────────
# DB-backed notification queue is always on unless explicitly disabled.
NOTIFICATIONS_ENABLED=true

FIREBASE_CREDENTIALS_PATH=config/fcm.json