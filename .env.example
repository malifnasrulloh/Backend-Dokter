# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_database_password_here
DB_NAME=sik

# JWT Secret (CRITICAL: Use a strong random value in production)
# Generate with: openssl rand -hex 32
SECRETTOKEN=REPLACE_WITH_STRONG_SECRET_GENERATED_BY_OPENSSL

# Server Configuration
PORT=4002
NODE_ENV=development

# AES Encryption Keys for User Table
# These are used to decrypt user credentials from the database
DB_AES_KEY_USER=your_aes_user_key
DB_AES_KEY_PASS=your_aes_pass_key

# URL webapps
HOST_WEB=http://localhost
HOST_WEB_PORT=80
HOST_WEB_ROOT=webapps

# Redis (for rate limiter) - set to true to enable
REDIS_ENABLED=false

# Database Connection Pool
DB_CONNECTION_LIMIT=25
DISABLE_QUERY_LOG=false

# Access Control
# Set to 'false' to transition the mobile application into a read-only viewer.
ALLOW_MOBILE_WRITE=false
